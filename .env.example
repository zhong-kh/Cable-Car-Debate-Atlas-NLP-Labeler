LABELER_HOST=127.0.0.1
LABELER_PORT=7861
LABELER_USERNAME=
LABELER_PASSWORD=

# Optional path to the original source JSON. If absent, import from the app.
LABELER_SOURCE_PATH=

# Optional external crawler file or directory. The bundled crawler output is also monitored.
LABELER_CRAWLER_IMPORT_PATH=

# Run crawler at startup and then every 6 hours (21600 seconds).
SEILBAHN_CRAWL_INTERVAL_SECONDS=21600
SEILBAHN_DISABLE_CRAWLER=0
